{
    "layout": {
        "type": "grid",
        "rows": 2,
        "cols": 2,
        "hspace": "2mm",
        "vspace": "2mm",
        "rotation": "0deg",
        "alternation": "none",
        "renamenet": "Board_{n}-{orig}",
        "renameref": "{orig}"
    },
    "tabs": {
        "type": "spacing",
        "spacing": "30mm",
        "hwidth": "3mm",
        "vwidth": "3mm"
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.5mm",
        "spacing": "0.8mm",
        "prolong": "0.5mm"
    },
    "framing": {
        "type": "railstb",
        "vspace": "5mm",
        "hspace": "0mm",
        "width": "6mm"
    },
    "tooling": {
        "type": "3hole",
        "hoffset": "2.5mm",
        "voffset": "2.5mm",
        "size": "2mm"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "5mm",
        "voffset": "3.5mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "post": {
        "type": "auto",
        "copperfill": false,
        "origin": "tl"
    }
}
